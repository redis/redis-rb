{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/release_guard.sh",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Release guard"
          }
        ]
      }
    ]
  }
}
